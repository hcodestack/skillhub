#!/usr/bin/env bash
# skillhub — run the dashboard from anywhere.
#
#   skillhub            start the server (if needed) and open the dashboard
#   skillhub serve      run in the foreground
#   skillhub stop       stop the background server
#   skillhub status     is it running? where? watching which library?
#   skillhub path       print repo / library / config locations
#   skillhub update     pull the latest engine (git) and rebuild if needed
#   skillhub help       this help
#
# Config lives in ~/.skillhub/env (written by setup.sh; edit freely):
#   SKILLMGMNT_REPO / SKILLMGMNT_LIBRARY_ROOT / SKILLMGMNT_PORT
set -u

CONF="$HOME/.skillhub/env"
PID_FILE="$HOME/.skillhub/server.pid"
LOG_FILE="$HOME/.skillhub/server.log"

fail() { printf 'skillhub: %s\n' "$*" >&2; exit 1; }

[ -f "$CONF" ] || fail "not set up yet — run setup.sh in the repo first ($CONF missing)"
# shellcheck disable=SC1090
. "$CONF"
# The project was renamed from Skillhub. A config written before the rename
# holds SKILLHUB_* names, so promote any of those that have no new-name
# counterpart before anything reads them. Without this, an existing install
# reads empty values and stops working for a purely cosmetic reason.
# ${!prefix@} covers shell variables too, which matters because the config
# file assigns without `export` — an `env` scan would miss every one of them.
for _k in ${!SKILLHUB_@}; do
  _new="SKILLMGMNT_${_k#SKILLHUB_}"
  [ -n "${!_new:-}" ] || export "$_new=${!_k}"
done
unset _k _new

REPO="${SKILLMGMNT_REPO:-}"
PORT="${SKILLMGMNT_PORT:-8787}"
[ -d "$REPO/server" ] || fail "repo not found at $REPO (edit $CONF)"

# The venv created by setup means uv is a setup-time dependency only.
VENV_BIN="$REPO/server/.venv/bin/skillhub-server"

# Never build the command as a string: the repo path may contain spaces, and
# an unquoted expansion would split it (found in sandbox testing).
run_server() {   # replaces this process; caller sets the env
  cd "$REPO/server"
  if [ -x "$VENV_BIN" ]; then
    exec "$VENV_BIN"
  elif command -v uv >/dev/null 2>&1; then
    exec uv run skillhub-server
  fi
  fail "no server runtime (run setup.sh again)"
}

running() {
  [ -f "$PID_FILE" ] || return 1
  local pid; pid="$(cat "$PID_FILE" 2>/dev/null)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

start_bg() {
  if running; then return 0; fi
  [ -x "$VENV_BIN" ] || command -v uv >/dev/null 2>&1 \
    || fail "no server runtime (run setup.sh again)"
  mkdir -p "$(dirname "$LOG_FILE")"
  ( export SKILLMGMNT_LIBRARY_ROOT="$SKILLMGMNT_LIBRARY_ROOT" SKILLMGMNT_PORT="$PORT"
    cd "$REPO/server"
    if [ -x "$VENV_BIN" ]; then
      nohup "$VENV_BIN" >>"$LOG_FILE" 2>&1 &
    else
      nohup uv run skillhub-server >>"$LOG_FILE" 2>&1 &
    fi
    echo $! >"$PID_FILE" )
  # wait until it answers (max ~10s)
  for _ in $(seq 1 20); do
    curl -s -o /dev/null --max-time 1 "http://127.0.0.1:$PORT/api/v1/stats/tiles" && return 0
    sleep 0.5
  done
  fail "server did not come up — see $LOG_FILE"
}

open_url() {
  [ "${SKILLMGMNT_NO_OPEN:-}" = "1" ] && return 0
  command -v open >/dev/null 2>&1 && open "http://127.0.0.1:$PORT" && return
  command -v xdg-open >/dev/null 2>&1 && xdg-open "http://127.0.0.1:$PORT" && return
  printf 'dashboard: http://127.0.0.1:%s\n' "$PORT"
}

case "${1:-start}" in
  start)
    start_bg
    printf 'skillhub running · http://127.0.0.1:%s · library: %s\n' "$PORT" "$SKILLMGMNT_LIBRARY_ROOT"
    open_url
    ;;
  serve)
    export SKILLMGMNT_LIBRARY_ROOT="$SKILLMGMNT_LIBRARY_ROOT" SKILLMGMNT_PORT="$PORT"
    run_server
    ;;
  stop)
    if running; then
      kill "$(cat "$PID_FILE")" && rm -f "$PID_FILE" && echo "stopped"
    else
      rm -f "$PID_FILE"; echo "not running"
    fi
    ;;
  status)
    if running; then
      echo "running (pid $(cat "$PID_FILE")) · http://127.0.0.1:$PORT"
    else
      echo "not running"
    fi
    echo "library: $SKILLMGMNT_LIBRARY_ROOT"
    echo "repo:    $REPO"
    ;;
  path)
    echo "repo:    $REPO"
    echo "library: $SKILLMGMNT_LIBRARY_ROOT"
    echo "config:  $CONF"
    echo "log:     $LOG_FILE"
    ;;
  update)
    exec bash "$REPO/update.sh"
    ;;
  help|-h|--help)
    sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    fail "unknown command: $1 (see skillhub help)"
    ;;
esac
